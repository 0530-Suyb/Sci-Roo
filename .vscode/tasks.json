// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "bundle",
			"type": "shell",
			"command": "pnpm --dir src bundle",
			"options": {
				"env": {
					"PATH": "${workspaceFolder}\\.tools\\node-v20.19.2-win-x64;${env:PATH}"
				}
			},
			"group": "build",
			"presentation": {
				"group": "watch",
				"reveal": "always"
			}
		},
		{
			"label": "build:webview",
			"type": "shell",
			"command": "pnpm --filter @roo-code/vscode-webview build",
			"options": {
				"env": {
					"PATH": "${workspaceFolder}\\.tools\\node-v20.19.2-win-x64;${env:PATH}"
				}
			},
			"group": "build",
			"presentation": {
				"group": "watch",
				"reveal": "always"
			}
		},
		{
			"label": "build:extension-dev",
			"dependsOn": ["build:webview", "bundle"],
			"dependsOrder": "sequence",
			"presentation": {
				"reveal": "never"
			}
		},
		{
			"label": "dev:extension-with-billing-mock",
			"dependsOn": ["build:extension-dev", "dev:billing-mock-site"],
			"dependsOrder": "sequence",
			"presentation": {
				"reveal": "never"
			}
		},
		{
			"label": "watch",
			"dependsOn": ["watch:webview", "watch:bundle"],
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "watch:webview",
			"type": "shell",
			"command": "pnpm --filter @roo-code/vscode-webview dev",
			"options": {
				"env": {
					"PATH": "${workspaceFolder}\\.tools\\node-v20.19.2-win-x64;${env:PATH}"
				}
			},
			"group": "build",
			"problemMatcher": {
				"owner": "vite",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*VITE.*",
					"endsPattern": ".*Local:.*"
				}
			},
			"isBackground": true,
			"presentation": {
				"group": "watch",
				"reveal": "always"
			}
		},
		{
			"label": "watch:bundle",
			"type": "shell",
			"command": "node src/esbuild.mjs --watch",
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"PATH": "D:\\nodejs;${env:PATH}"
				}
			},
			"group": "build",
			"problemMatcher": {
				"owner": "esbuild",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "esbuild-problem-matcher#onStart",
					"endsPattern": "esbuild-problem-matcher#onEnd"
				}
			},
			"isBackground": true,
			"presentation": {
				"group": "watch",
				"reveal": "always"
			}
		},
		{
			"label": "dev:billing-mock-site",
			"type": "shell",
			"command": "pnpm --filter @roo-code/web-roo-code dev",
			"options": {
				"env": {
					"SCI_ROO_ENABLE_BILLING_MOCK": "true",
					"PATH": "${workspaceFolder}\\.tools\\node-v20.19.2-win-x64;${env:PATH}"
				}
			},
			"isBackground": true,
			"problemMatcher": {
				"owner": "nextjs",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*next dev.*|.*Starting.*",
					"endsPattern": ".*Local:.*http://localhost:3000.*"
				}
			},
			"presentation": {
				"group": "watch",
				"reveal": "always"
			}
		},
		{
			"label": "watch:tsc",
			"type": "shell",
			"command": "npx turbo watch:tsc",
			"options": {
				"env": {
					"PATH": "${workspaceFolder}\\.tools\\node-v20.19.2-win-x64;${env:PATH}"
				}
			},
			"group": "build",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"group": "watch",
				"reveal": "always"
			}
		}
	]
}
