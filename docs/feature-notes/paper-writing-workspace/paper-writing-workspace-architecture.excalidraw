    },
    {
      "id": "l2-right-tab2-outline",
      "type": "rectangle",
      "x": 960,
      "y": 580,
      "width": 780,
      "height": 185,
      "strokeColor": "#ce93d8",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
