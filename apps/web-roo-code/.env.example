# PostHog Analytics Configuration
# Replace these values with your actual PostHog API key and host
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_api_key_here

# Basin Form Endpoint for Static Form Submissions
# Replace this with your actual Basin form endpoint (e.g., https://usebasin.com/f/your-form-id)
NEXT_PUBLIC_BASIN_ENDPOINT=https://usebasin.com/f/your-form-id-here

# Site URL Configuration
# Used for generating absolute URLs in sitemap and other contexts
NEXT_PUBLIC_SITE_URL=https://roocode.com

# Billing Mock Configuration
# Enable the local mock billing endpoints used by the extension integration flow.
SCI_ROO_ENABLE_BILLING_MOCK=true

# Billing Provider
# Force the web billing routes onto a specific implementation.
# Supported values today: mock, real
SCI_ROO_BILLING_PROVIDER=mock

# Real Billing Provider Scaffold
# When using SCI_ROO_BILLING_PROVIDER=real, these variables shape the auth and entitlement responses.
SCI_ROO_BILLING_REAL_REQUIRE_AUTH=true
SCI_ROO_BILLING_REAL_DEFAULT_TIER=free
SCI_ROO_BILLING_REAL_ENTITLEMENTS_JSON={"token:dev-pro-user":{"tier":"pro"}}
SCI_ROO_BILLING_REAL_CHECKOUT_BASE_URL=https://billing.example.com/checkout
SCI_ROO_BILLING_REAL_PORTAL_BASE_URL=https://billing.example.com/portal
